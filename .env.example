# Variáveis públicas (VITE_*) — expostas ao cliente. Copie este arquivo
# para .env e preencha. NUNCA commitar .env real.
#
# Secrets de servidor (Stripe secret keys, service role, webhook secrets)
# NÃO ficam aqui — são configurados em Lovable Cloud > Secrets.

# Runtime publico da aplicacao. Use "development", "staging" ou "production".
LOCALIX_ENV="development"

# URL publica da aplicacao deste ambiente.
APP_BASE_URL="http://localhost:5173"

# Base publica das Edge Functions deste ambiente, sem barra final.
# Ex.: https://<project-ref>.supabase.co/functions/v1
LOCALIX_SUPABASE_FUNCTIONS_BASE_URL="https://<project-ref>.supabase.co/functions/v1"

# Tag explicita do projeto Supabase usado por este runtime.
# Deve coincidir com LOCALIX_ENV.
LOCALIX_SUPABASE_ENVIRONMENT="development"

# Use "sandbox" em development/staging e "production" apenas em producao.
MP_ENVIRONMENT="sandbox"

# Referencias nao secretas usadas para impedir staging apontando para producao.
PRODUCTION_APP_BASE_URL="https://localixdelivery.rngdigital.com.br"
PRODUCTION_LOCALIX_SUPABASE_FUNCTIONS_BASE_URL="https://<production-project-ref>.supabase.co/functions/v1"

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Secrets server-side: configurar somente no provedor/server runtime.
# Nunca expor no frontend e nunca commitar valores reais.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<server-side-only>"
MP_APP_ID="<server-side-only>"
MP_CLIENT_SECRET="<server-side-only>"
MP_TEST_ACCESS_TOKEN="<server-side-only>"
MP_WEBHOOK_SECRET="<server-side-only>"
MP_TOKEN_ENCRYPTION_KEY="<server-side-only>"
